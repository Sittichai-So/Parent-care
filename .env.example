# Base URL of the parent-care-backend API. EXPO_PUBLIC_-prefixed vars are
# inlined into the client bundle by Expo — see src/services/api-client.ts.
# Use your machine's LAN IP instead of localhost when testing on a physical
# device or the Android emulator (which can't reach the host's localhost).
EXPO_PUBLIC_API_URL=http://localhost:8024/api
